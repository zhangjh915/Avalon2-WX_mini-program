page {
  background: #121816;
  color: #f6f1e8;
}

button {
  margin: 0;
}

button::after {
  border: 0;
}

.game-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 64rpx;
  box-sizing: border-box;
  background: #121816;
}

.game-header,
.round-strip,
.action-heading,
.selection-progress,
.result-hero,
.choice-action,
.sheet-header {
  display: flex;
  align-items: center;
}

.game-header {
  justify-content: space-between;
  min-height: 92rpx;
  margin-bottom: 22rpx;
}

.header-copy {
  min-width: 0;
}

.room-kicker,
.action-kicker,
.leader-label,
.identity-eyebrow,
.secret-label {
  font-size: 20rpx;
  color: #9aa9a4;
  line-height: 1.4;
}

.room-name {
  max-width: 540rpx;
  margin-top: 3rpx;
  overflow: hidden;
  color: #f6f1e8;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seat-map-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  padding: 0;
  border: 2rpx solid #43514c;
  border-radius: 50%;
  background: #1c2522;
  color: #d7c395;
  font-size: 24rpx;
  font-weight: 800;
}

.mission-board {
  position: relative;
  display: flex;
  justify-content: space-between;
  padding: 16rpx 10rpx 8rpx;
  margin-bottom: 24rpx;
}

.mission-line {
  position: absolute;
  top: 50rpx;
  left: 10%;
  right: 10%;
  height: 3rpx;
  background: #36423e;
}

.mission-stop {
  position: relative;
  z-index: 1;
  display: flex;
  width: 92rpx;
  flex-direction: column;
  align-items: center;
}

.mission-orb {
  /* 四态各是一张完整图标（自带圆形外观），不再用 CSS 圆框 + 汉字。
     底色也不能再用绿/红——阵营色由队徽自己承载，绿徽压绿底会糊成一团。 */
  position: relative;
  width: 68rpx;
  height: 68rpx;
}



.mission-success { animation: mission-stamp 0.48s ease-out; }

.mission-fail { animation: mission-stamp 0.48s ease-out; }

.mission-current { animation: mission-orb-spin 9s linear infinite; }

.protection-mark {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #121816;
  border-radius: 50%;
  background: #d9bb78;
  color: #dfe3e1;
  font-size: 18rpx;
  font-weight: 900;
}

.mission-size {
  margin-top: 10rpx;
  color: #85938e;
  font-size: 20rpx;
}

.round-strip {
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 2rpx;
  margin-bottom: 24rpx;
}

.round-title {
  font-size: 30rpx;
  font-weight: 800;
}

.round-meta {
  max-width: 370rpx;
  margin-top: 5rpx;
  color: #95a19d;
  font-size: 21rpx;
  line-height: 1.4;
}

.leader-chip {
  display: flex;
  align-items: center;
  max-width: 270rpx;
  padding: 12rpx 16rpx 12rpx 12rpx;
  border: 2rpx solid #46524e;
  border-radius: 8rpx;
  background: #1b2421;
  box-sizing: border-box;
}

.crown-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #d4b36b;
  color: #e0e4e2;
  font-size: 20rpx;
  font-weight: 900;
}

.leader-copy {
  min-width: 0;
}

.leader-name {
  overflow: hidden;
  color: #f4eee3;
  font-size: 22rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-card {
  position: relative;
  min-height: 330rpx;
  padding: 34rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 2rpx solid #596b64;
  border-radius: 8rpx;
  background: #263b35;
  box-sizing: border-box;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.22);
  transform-origin: center;
  transition: transform 0.22s ease, background-color 0.25s ease, border-color 0.25s ease;
}

.identity-card::before,
.identity-card::after {
  position: absolute;
  content: "";
  pointer-events: none;
}

.identity-card::before {
  top: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  left: 16rpx;
  border: 2rpx solid rgba(69, 61, 44, 0.34);
}

.identity-card::after {
  top: 0;
  right: 0;
  width: 128rpx;
  height: 128rpx;
  border-left: 2rpx solid rgba(69, 61, 44, 0.18);
  border-bottom: 2rpx solid rgba(69, 61, 44, 0.18);
  transform: translate(42rpx, -42rpx) rotate(45deg);
}

.identity-pressing {
  transform: scale(0.99);
}

.identity-back {
  position: relative;
  z-index: 1;
  display: flex;
  min-height: 258rpx;
  align-items: center;
}

.identity-sigil {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 188rpx;
  margin-right: 34rpx;
  border: 4rpx solid #453d2c;
  border-radius: 75rpx 75rpx 28rpx 28rpx;
  background: #1a2b26;
  box-sizing: border-box;
}

.sigil-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border: 2rpx solid #453d2c;
  border-radius: 50%;
  color: #e5d09e;
  font-size: 44rpx;
  font-weight: 900;
}

.identity-back-copy {
  flex: 1;
  min-width: 0;
}

.identity-eyebrow {
  color: #b9c6c1;
}

.identity-title {
  margin: 12rpx 0 30rpx;
  color: #fffaf0;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.1;
}

.identity-hold {
  color: #d9c591;
  font-size: 22rpx;
}

.identity-open {
  height: 760rpx;
  min-height: 620rpx;
  animation: identity-reveal 0.58s cubic-bezier(0.2, 0.78, 0.24, 1);
}

.identity-open.faction-good {
  background: #1d6b59;
  border-color: #77bea6;
}

.identity-open.faction-evil {
  background: #79363c;
  border-color: #cf8587;
}

.identity-front {
  position: relative;
  z-index: 1;
  display: flex;
  height: 690rpx;
  flex-direction: column;
  box-sizing: border-box;
}

.role-scroll {
  min-height: 0;
  padding-right: 6rpx;
  padding-bottom: 16rpx;
  overflow-y: auto;
  flex: 1;
}

.identity-faction {
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  font-weight: 700;
}

.role-name {
  margin: 10rpx 0 16rpx;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.15;
}

.role-rule {
  max-width: 610rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  line-height: 1.65;
}

.secret-intel {
  padding-top: 18rpx;
  margin-top: 20rpx;
  border-top: 2rpx solid rgba(19, 22, 20, 0.24);
}

.secret-label {
  margin-bottom: 7rpx;
  color: rgba(255, 255, 255, 0.6);
}

.secret-line {
  color: #ffffff;
  font-size: 23rpx;
  line-height: 1.55;
}

.guide-section {
  padding-top: 18rpx;
  margin-top: 18rpx;
  border-top: 2rpx solid rgba(19, 22, 20, 0.2);
}

.guide-label,
.warning-label {
  margin-bottom: 8rpx;
  color: rgba(255, 255, 255, 0.64);
  font-size: 20rpx;
  font-weight: 800;
}

.guide-goal,
.guide-tip,
.guide-warning {
  color: #ffffff;
  font-size: 23rpx;
  line-height: 1.58;
}

.guide-tip {
  display: flex;
  margin-top: 10rpx;
}

.guide-tip-no {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  min-width: 32rpx;
  margin-top: 2rpx;
  margin-right: 12rpx;
  border: 2rpx solid rgba(19, 22, 20, 0.48);
  border-radius: 50%;
  font-size: 17rpx;
  font-weight: 900;
  line-height: 32rpx;
  text-align: center;
}

.guide-warning {
  padding: 16rpx;
  margin-top: 20rpx;
  border: 2rpx solid rgba(19, 22, 20, 0.25);
  border-radius: 6rpx;
  background: rgba(20, 22, 20, 0.16);
}

.reading-timer {
  padding-top: 14rpx;
  border-top: 2rpx solid rgba(19, 22, 20, 0.24);
}

.reading-progress {
  height: 8rpx;
  overflow: hidden;
  border-radius: 4rpx;
  background: rgba(19, 22, 20, 0.2);
}

.reading-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: #3e3828;
  transition: width 0.2s linear;
}

.reading-seconds {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 19rpx;
  text-align: right;
}

.identity-countdown-card .identity-back {
  opacity: 0.12;
}

.identity-countdown {
  position: absolute;
  z-index: 4;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background: rgba(17, 31, 27, 0.88);
}

.countdown-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 138rpx;
  height: 138rpx;
  border: 4rpx solid #453d2c;
  border-radius: 50%;
  color: #f8e8bd;
  font-size: 68rpx;
  font-weight: 900;
  animation: countdown-pulse 0.9s ease-in-out infinite;
}

.countdown-copy {
  margin-top: 22rpx;
  color: #d9caa7;
  font-size: 23rpx;
}

.action-card {
  padding: 28rpx;
  border-radius: 8rpx;
  background: #191e1c;
  color: #e0e3e2;
  box-sizing: border-box;
}

.action-heading {
  position: relative;
  padding-bottom: 22rpx;
  border-bottom: 2rpx solid #232a27;
}

.phase-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #202925;
  color: #f1dfb2;
  font-size: 26rpx;
  font-weight: 900;
}

.action-kicker {
  color: #85847f;
}

.action-title {
  font-size: 31rpx;
  font-weight: 900;
}

.host-badge {
  margin-left: auto;
  padding: 7rpx 12rpx;
  border: 2rpx solid #c9ab69;
  border-radius: 6rpx;
  color: #e2d6bc;
  font-size: 19rpx;
  font-weight: 800;
}

.phase-content {
  padding-top: 24rpx;
}

.action-copy,
.waiting-copy,
.script-text,
.notice-line {
  color: #b9c1bd;
  font-size: 24rpx;
  line-height: 1.6;
}

.status-note {
  display: flex;
  align-items: center;
  padding: 18rpx;
  margin-top: 20rpx;
  border-radius: 6rpx;
  background: #1c211e;
  color: #c3cac6;
  font-size: 23rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #3a8a70;
  box-shadow: 0 0 0 7rpx rgba(58, 138, 112, 0.12);
}

.primary-action,
.secondary-action,
.launch-action {
  width: 100%;
  min-height: 88rpx;
  margin-top: 20rpx;
  border-radius: 6rpx;
  font-size: 26rpx;
  font-weight: 800;
  transition: transform 0.1s ease, opacity 0.1s ease, background-color 0.15s ease;
}

.button-hover,
.pressable.button-hover,
.primary-action:active,
.secondary-action:active,
.launch-action:active,
.choice-action:active,
.vote-card:active {
  opacity: 0.82;
  transform: scale(0.975);
}

.primary-action {
  background: #263d36;
  color: #ffffff;
}

.secondary-action {
  border: 2rpx solid #303935;
  background: transparent;
  color: #d6dbd9;
}

.launch-action {
  background: #c4a258;
  color: #e0e4e2;
}

.primary-action[disabled] {
  background: #272f2b;
  color: #8b8d89;
}

.reveal-script {
  margin-top: 22rpx;
}

.script-step {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #212824;
  animation: script-enter 0.38s ease-out both;
}

.script-step:nth-child(2) { animation-delay: 0.05s; }
.script-step:nth-child(3) { animation-delay: 0.1s; }
.script-step:nth-child(4) { animation-delay: 0.15s; }
.script-step:nth-child(5) { animation-delay: 0.2s; }

.identity-ready-grid {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  flex-wrap: wrap;
  padding: 24rpx 4rpx 10rpx;
}

.ready-orb {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid #2a332f;
  border-radius: 50%;
  background: #1e2421;
  color: #8a8e8a;
  font-size: 18rpx;
  font-weight: 900;
  transition: all 0.25s ease;
}

.ready-orb.ready,
.ready-orb.remembered {
  border-color: #367a63;
  background: #367a63;
  color: #ffffff;
  animation: ready-pop 0.3s ease-out;
}

.ready-orb.remembered {
  border-color: #aa8742;
  background: #aa8742;
}

.ready-count {
  color: #aeb7b3;
  font-size: 21rpx;
  text-align: center;
}

.ceremony-waiting {
  padding: 8rpx 0;
}

.night-screen {
  padding: 28rpx 0 8rpx;
}

.night-moon {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 22rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #d5c38f;
  box-shadow: 0 0 30rpx rgba(213, 195, 143, 0.25);
}

.night-moon::after {
  position: absolute;
  top: -10rpx;
  left: 32rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #191e1c;
  content: "";
}

.script-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #263d36;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
}

.script-body {
  flex: 1;
}

.script-role {
  margin-bottom: 5rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.notice-box {
  padding: 18rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #bd9346;
  background: #1e2421;
}

.notice-line + .notice-line {
  margin-top: 8rpx;
}

.selection-progress {
  min-height: 76rpx;
}

.selection-count {
  min-width: 86rpx;
  color: #d9dddb;
  font-size: 38rpx;
  font-weight: 900;
}

.selection-copy {
  flex: 1;
}

.selection-title,
.waiting-title {
  color: #dfe2e0;
  font-size: 27rpx;
  font-weight: 900;
}

.selection-subtitle {
  margin-top: 2rpx;
  color: #83847f;
  font-size: 21rpx;
}

.selection-state {
  padding: 7rpx 11rpx;
  border-radius: 6rpx;
  background: #202623;
  color: #b0b9b4;
  font-size: 19rpx;
  font-weight: 800;
}

.selection-state.ready {
  background: #1f2522;
  color: #c0e0d5;
}

.selected-riders,
.team-inline,
.vote-actions {
  display: flex;
  flex-wrap: wrap;
}

.selected-riders {
  gap: 18rpx;
  padding: 22rpx 0 4rpx;
}

.rider-token {
  position: relative;
  display: flex;
  width: 86rpx;
  flex-direction: column;
  align-items: center;
}

.rider-avatar,
.team-inline-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #1e2421;
  color: #d7dcda;
  font-weight: 900;
}

.rider-avatar {
  width: 66rpx;
  height: 66rpx;
  border: 3rpx solid transparent;
  font-size: 24rpx;
}

.magic-rider .rider-avatar {
  border-color: #b38a3e;
  background: #212824;
}

.rider-no {
  margin-top: 7rpx;
  color: #b8c0bc;
  font-size: 20rpx;
}

.tiny-magic {
  position: absolute;
  top: -5rpx;
  right: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #b38a3e;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 900;
}

.waiting-emblem,
.submitted-seal,
.amulet-emblem {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  margin: 8rpx auto 18rpx;
  border-radius: 50%;
  background: #263d36;
  color: #f1dfb2;
  font-size: 36rpx;
  font-weight: 900;
}

.waiting-title,
.waiting-copy {
  text-align: center;
}

.waiting-copy {
  margin-top: 8rpx;
}

.team-inline {
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.team-inline-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx 8rpx 8rpx;
  border-radius: 30rpx;
  background: #1d2320;
  color: #c7cdca;
  font-size: 20rpx;
}

.team-inline-item.has-magic {
  border: 2rpx solid #b38a3e;
  background: #1e2421;
}

.team-inline-avatar {
  width: 40rpx;
  height: 40rpx;
  font-size: 18rpx;
}

.vote-actions {
  gap: 16rpx;
  margin-top: 22rpx;
}

.vote-card {
  display: flex;
  min-width: 0;
  min-height: 190rpx;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  color: #ffffff;
}

.vote-success {
  background: #247760;
}

.vote-fail {
  background: #983f46;
}

.vote-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 12rpx;
  border: 3rpx solid rgba(19, 22, 20, 0.7);
  border-radius: 50%;
  font-size: 27rpx;
  font-weight: 900;
}

.vote-label {
  font-size: 24rpx;
  font-weight: 800;
}

.submitted-state {
  padding: 12rpx 0 4rpx;
}

.submitted-seal {
  background: #27755f;
  color: #ffffff;
}

.submitted-seal.spectator {
  background: #5c6561;
}

.vote-progress {
  height: 10rpx;
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 5rpx;
  background: #222925;
}

.vote-progress-fill {
  height: 100%;
  background: #b28d43;
  transition: width 0.25s ease;
}

.vote-progress-copy {
  margin-top: 9rpx;
  color: #858681;
  font-size: 20rpx;
  text-align: center;
}

.result-hero {
  padding: 22rpx;
  border-radius: 8rpx;
  animation: result-enter 0.48s cubic-bezier(0.2, 0.78, 0.24, 1);
}

.result-good {
  background: #1e2421;
  color: #c2e2d7;
}

.result-evil {
  background: #1d2220;
  color: #d8b0b4;
}

.result-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  margin-right: 20rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 900;
}

.result-title {
  font-size: 31rpx;
  font-weight: 900;
}

.result-detail {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.handoff-actions {
  margin-top: 20rpx;
}

.choice-action {
  width: 100%;
  min-height: 104rpx;
  padding: 14rpx 6rpx;
  border-bottom: 2rpx solid #212824;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.choice-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  font-size: 21rpx;
  font-weight: 900;
}

.crown-choice {
  background: #232a26;
  color: #dfd3b6;
}

.amulet-choice {
  background: #1f2522;
  color: #cdd3d0;
}

.choice-copy {
  flex: 1;
}

.choice-label {
  color: #dbdfdd;
  font-size: 24rpx;
  font-weight: 800;
}

.choice-value {
  margin-top: 3rpx;
  color: #898985;
  font-size: 20rpx;
}

.choice-arrow {
  color: #9c9d98;
  font-size: 38rpx;
}

.amulet-emblem {
  border: 3rpx solid #b28d43;
  background: #202623;
  color: #e0d4ba;
}

.muted-emblem {
  border: 0;
  background: #1e2421;
  color: #b5beb9;
}

.inspection-result {
  padding: 26rpx;
  border-radius: 8rpx;
  text-align: center;
}

.inspection-result.faction-good {
  background: #1e2421;
  color: #c2e2d7;
}

.inspection-result.faction-evil {
  background: #1d2220;
  color: #d8b0b4;
}

.inspection-no,
.inspection-label {
  font-size: 21rpx;
}

.inspection-faction {
  margin: 8rpx 0 20rpx;
  font-size: 45rpx;
  font-weight: 900;
}

.finale-banner {
  padding: 18rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #a77a7f;
  color: #d5afb3;
  font-size: 30rpx;
  font-weight: 900;
  text-align: center;
}

.danger-launch {
  background: #923b42;
  color: #ffffff;
}

.duke-options {
  padding-top: 22rpx;
}

.debug-drawer {
  margin-top: 18rpx;
  text-align: center;
}

.debug-toggle,
.debug-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 18rpx;
  border: 2rpx solid #414c48;
  border-radius: 6rpx;
  background: transparent;
  color: #84908b;
  font-size: 20rpx;
}

.debug-content {
  padding: 18rpx;
  margin-top: 10rpx;
  border: 2rpx dashed #3e4945;
  color: #a6b0ac;
  font-size: 21rpx;
  text-align: left;
}

.debug-list,
.debug-vote-row {
  margin-top: 10rpx;
  line-height: 1.6;
}

.debug-vote-row button {
  margin-left: 8rpx;
}

.table-overlay {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(5, 10, 8, 0.76);
  animation: overlay-in 0.2s ease-out;
}

.table-sheet {
  width: 100%;
  max-height: 94vh;
  padding: 12rpx 24rpx 30rpx;
  overflow-y: auto;
  border-radius: 8rpx 8rpx 0 0;
  background: #1c211e;
  box-sizing: border-box;
  color: #dfe2e0;
  animation: sheet-up 0.32s cubic-bezier(0.2, 0.82, 0.25, 1);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 14rpx;
  border-radius: 4rpx;
  background: #55635c;
}

.sheet-header {
  justify-content: space-between;
  min-height: 80rpx;
  padding: 0 4rpx 16rpx;
}

.sheet-title {
  font-size: 31rpx;
  font-weight: 900;
}

.sheet-hint {
  max-width: 570rpx;
  margin-top: 4rpx;
  color: #aeb7b3;
  font-size: 21rpx;
  line-height: 1.4;
}

.round-table {
  width: 330rpx;
  height: 330rpx;
  /* 必须保留：table-round.jpg 带黑色四角，靠这个圆角裁掉 */
  border-radius: 50%;
  overflow: hidden;
}

/* 长桌尺寸由 js 按实测 stage 算好内联下发，这里不能再写死宽高或圆角 */

.table-emblem {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  border: 3rpx solid rgba(225, 195, 126, 0.65);
  border-radius: 50%;
  color: #e0c27c;
  font-size: 40rpx;
  font-weight: 900;
  transform: translate(-50%, -50%);
}

.seat-token {
  position: absolute;
  display: flex;
  width: 110rpx;
  min-height: 110rpx;
  padding: 7rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #303934;
  border-radius: 50%;
  background: #171b19;
  box-sizing: border-box;
  box-shadow: 0 7rpx 15rpx rgba(45, 38, 29, 0.18);
  text-align: center;
  transform: translate(-50%, -50%);
  transition: opacity 0.16s ease, background-color 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
}

.seat-token.mine {
  border-color: #3d8a70;
}

.seat-token.selected {
  border-color: #298064;
  background: #1e2421;
  box-shadow: 0 0 0 7rpx rgba(41, 128, 100, 0.13);
}

.seat-token.danger-selected {
  border-color: #a9454c;
  background: #1d221f;
  box-shadow: 0 0 0 7rpx rgba(169, 69, 76, 0.12);
}

.seat-token.leader-selected {
  border-color: #b58c3d;
  background: #202623;
}

.seat-token.amulet-selected {
  border-color: #3b8170;
  background: #1e2421;
}

.seat-token.leader {
  border-style: double;
}

.seat-token.seat-disabled {
  opacity: 0.38;
}

.seat-token .seat-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 2rpx;
  border-radius: 50%;
  background: #364a43;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
}

.seat-no {
  color: #c4cac7;
  font-size: 18rpx;
  font-weight: 900;
}

.seat-name {
  max-width: 92rpx;
  overflow: hidden;
  color: #d9dddb;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seat-badge {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #1c211e;
  border-radius: 50%;
  color: #ffffff;
  font-size: 14rpx;
  font-weight: 900;
}

.crown-badge {
  top: -5rpx;
  left: 2rpx;
  background: #b58c3d;
}

.magic-badge {
  top: -5rpx;
  right: 2rpx;
  background: #53699b;
}

.retired-badge {
  right: 0;
  bottom: 2rpx;
  background: #777b77;
}

.sheet-actions {
  padding-top: 2rpx;
}

@keyframes identity-reveal {
  0% { opacity: 0.3; transform: perspective(900rpx) rotateY(90deg) scale(0.96); }
  100% { opacity: 1; transform: perspective(900rpx) rotateY(0deg) scale(1); }
}

@keyframes countdown-pulse {
  0%, 100% { transform: scale(0.92); opacity: 0.72; }
  50% { transform: scale(1); opacity: 1; }
}

@keyframes mission-stamp {
  0% { opacity: 0; transform: scale(1.55) rotate(-10deg); }
  70% { transform: scale(0.9) rotate(2deg); }
  100% { opacity: 1; transform: scale(1) rotate(0); }
}

@keyframes current-mission-pulse {
  0%, 100% { box-shadow: 0 0 0 6rpx rgba(217, 187, 120, 0.1); }
  50% { box-shadow: 0 0 0 12rpx rgba(217, 187, 120, 0.18); }
}

@keyframes ready-pop {
  0% { transform: scale(0.7); }
  70% { transform: scale(1.12); }
  100% { transform: scale(1); }
}

@keyframes script-enter {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes result-enter {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes overlay-in {
  from { background: rgba(5, 10, 8, 0); }
  to { background: rgba(5, 10, 8, 0.76); }
}

@keyframes sheet-up {
  from { opacity: 0.5; transform: translateY(100%); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-height: 700px) {
  .compact-stage {
    min-height: 520rpx;
  }

  .identity-card {
    min-height: 292rpx;
  }
}

/* Current multiplayer flow */
.play-page { min-height: 100vh; padding: 20rpx 24rpx 54rpx; box-sizing: border-box; background: #121816; }
.mission-header { width: 100%; max-width: 760rpx; margin: 0 auto; }
.phase-shell { width: 100%; max-width: 760rpx; margin: 0 auto; }
.phase-content { display: flex; min-height: 480rpx; padding: 26rpx 4rpx; flex-direction: column; align-items: center; box-sizing: border-box; }
.identity-content { padding-top: 14rpx; }
.round-strip { margin-bottom: 8rpx; }
.round-kicker { margin-bottom: 5rpx; color: #cdb270; font-size: 20rpx; font-weight: 800; }
.table-icon-button { display: flex; width: 58rpx; min-width: 58rpx; max-width: 58rpx; height: 58rpx; min-height: 58rpx; max-height: 58rpx; padding: 0; flex: 0 0 58rpx; align-items: center; justify-content: center; border: 2rpx solid #48554f; border-radius: 5rpx; background: #1d2824; box-sizing: border-box; color: #d8c27f; }
.leader-line { display: flex; min-height: 72rpx; padding: 10rpx 14rpx; align-items: center; border: 2rpx solid #404d47; border-radius: 7rpx; background: #1a2420; box-sizing: border-box; color: #ece7dc; font-size: 23rpx; }
.leader-crown { display: flex; width: 46rpx; height: 46rpx; margin-right: 12rpx; flex: 0 0 auto; align-items: center; justify-content: center; }
/* 换成 <image> 后必须显式给尺寸：图片按自然尺寸渲染（96~224px），
   原来的 font-size 规则对图片无效，远征记录里的图标就是这么撑爆排版的。 */
.symbol-icon { display: block; width: 32rpx; height: 32rpx; flex: none; }
.crown-icon { width: 34rpx; height: 34rpx; }
.amulet-icon,.fire-icon { width: 32rpx; height: 32rpx; }
.inline-amulet-icon { width: 26rpx; height: 26rpx; margin-right: 8rpx; }
.faded-amulet-icon { width: 26rpx; height: 26rpx; }
.history-label .symbol-icon { width: 28rpx; height: 28rpx; }
.history-section-title .symbol-icon { width: 26rpx; height: 26rpx; }
.leader-crown .crown-icon { width: 30rpx; height: 30rpx; }
.rider-fire { width: 28rpx; height: 28rpx; }
.seat-badge .symbol-icon { width: 100%; height: 100%; }
.crown-icon { color: #f1c84c; }
.fire-icon { color: #ef6c3f; }
.amulet-icon { color: #4c9cce; }
.leader-rule { margin-left: auto; color: #8f9c96; font-size: 20rpx; }
/* 不要 min-height：prepare 模式下 .submitted-state 嵌在 .identity-waiting 里，
   两个 440rpx 叠加白吃 229pt，直接把按钮顶出屏幕。高度让内容自己决定。 */
.identity-waiting { display: flex; width: 100%; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
/* 已提交状态压成紧凑横排，不再是撑满的居中块 */
.submitted-state { display: flex; margin: 8rpx 0; align-items: center; justify-content: center; gap: 14rpx; text-align: center; }
.submitted-state .waiting-title { margin: 0; font-size: 27rpx; }
/* 印章里放自己的角色立绘，状态交给边框。
   原来 10 处共用一张底纹、只靠一个汉字区分，「该我动」和「我交完了」在视觉上
   几乎没差别，玩家得读字才知道要不要动。现在动静一分就够了：
   会呼吸的 = 在等别人，压死的 = 你已经交了。
   放大到 132rpx 是因为 64rpx 的圆里人脸只有 10pt，糊成一团。 */
.submitted-seal { position: relative; display: flex; width: 132rpx; height: 132rpx; margin: 0; align-items: center; justify-content: center; border: 3rpx solid #a98d4e; border-radius: 50%; overflow: hidden; box-sizing: border-box; }
/* 印章里放自己的座位头像（名字首字），不是角色立绘、也不是卡背——
   那两样都会在身份揭示前后把牌面又摆一遍。状态仍然由边框的动静表达。 */
/* 位置与铺满在 app.wxss 的垫底图规则里，这里只补圆角 */
.seal-base { border-radius: 50%; }
.seal-initial { position: relative; z-index: 1; display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; border-radius: 50%; background: #2c3a34; color: #e8e3d8; font-size: 44rpx; font-weight: 900; }
.submitted-seal.spectator { border-color: #647169; }

/* 等着别人——边框呼吸 */
.submitted-seal.seal-waiting { animation: seal-breathe 2.1s ease-in-out infinite; }
@keyframes seal-breathe {
  0%, 100% { border-color: #6d6250; box-shadow: 0 0 0 0 rgba(169, 141, 78, .34); }
  50% { border-color: #a98d4e; box-shadow: 0 0 0 10rpx rgba(169, 141, 78, 0); }
}
/* 我交完了——金边点亮一次然后压死不动 */
.submitted-seal.seal-sealed { border-width: 4rpx; border-color: #d8b76a; animation: seal-stamp 420ms cubic-bezier(.2,.8,.3,1) both; }
@keyframes seal-stamp {
  from { transform: scale(1.14); box-shadow: 0 0 0 14rpx rgba(216, 183, 106, .3); }
  to { transform: scale(1); box-shadow: 0 0 0 0 rgba(216, 183, 106, 0); }
}
/* 猎杀——红边急促脉冲，等专门的图到位后再换 */
.submitted-seal.seal-danger { border-color: #c4564a; animation: seal-danger-pulse 900ms ease-in-out infinite; }
@keyframes seal-danger-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(196, 86, 74, .45); }
  50% { box-shadow: 0 0 0 12rpx rgba(196, 86, 74, 0); }
}
.waiting-title { color: #f1ede5; font-size: 32rpx; font-weight: 900; text-align: center; }
.waiting-copy,.action-copy { max-width: 650rpx; margin: 14rpx auto 22rpx; color: #9eaaa4; font-size: 24rpx; line-height: 1.65; text-align: center; }
.identity-progress { margin-top: 18rpx; color: #9ca7a1; font-size: 22rpx; font-variant-numeric: tabular-nums; text-align: center; }
.primary-action,.secondary-action,.launch-action { width: 100%; min-height: 84rpx; margin-top: 14rpx; border-radius: 7rpx; font-size: 26rpx; font-weight: 900; }
.primary-action { background: #2f7358; color: #fff; }
.secondary-action { border: 2rpx solid #657169; background: #202b27; color: #e9ece9; }
.launch-action { background: #d0b36f; color: #e4e7e5; }
.identity-countdown { display: flex; min-height: 590rpx; flex-direction: column; align-items: center; justify-content: center; }
.countdown-number { color: #e4d195; font-size: 176rpx; font-weight: 900; animation: countdown-pulse 1s ease-in-out infinite; }
.selected-riders { display: flex; width: 100%; min-height: 128rpx; margin: 12rpx 0 22rpx; align-items: center; justify-content: center; flex-wrap: wrap; gap: 16rpx; }
.rider-token { display: flex; width: 86rpx; flex-direction: column; align-items: center; color: #aab4af; font-size: 19rpx; }
.rider-entering { animation: rider-board 520ms cubic-bezier(.18,.78,.22,1) both; }
.rider-avatar { position: relative; display: flex; width: 70rpx; height: 70rpx; margin-bottom: 6rpx; align-items: center; justify-content: center; border: 3rpx solid #57645e; border-radius: 50%; background: #202b27; color: #f3eee5; font-size: 25rpx; font-weight: 900; }
.rider-fire { position: absolute; top: -11rpx; right: -11rpx; font-size: 28rpx; }
.magic-rider .rider-avatar { border-color: #c6a95f; box-shadow: 0 0 0 6rpx rgba(198, 169, 95, 0.14); }
.vote-actions { display: grid; width: 100%; margin-top: 18rpx; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14rpx; }
.mission-vote { min-height: 142rpx; border-radius: 7rpx; color: #fff; font-size: 28rpx; font-weight: 900; }
.success-vote { background: #28745d; }
.fail-vote { background: #913e45; }
.vote-progress { width: 100%; height: 10rpx; margin-top: 28rpx; overflow: hidden; border-radius: 5rpx; background: #2d3934; }
.vote-progress-fill { height: 100%; background: #d0b36f; transition: width 220ms ease; }
.bot-vote-list { width: 100%; margin-top: 26rpx; padding-top: 18rpx; border-top: 2rpx solid #34413b; }
.bot-vote-row { display: grid; margin-top: 10rpx; grid-template-columns: 1fr 76rpx 76rpx; align-items: center; gap: 8rpx; color: #9eaaa4; font-size: 21rpx; }
.bot-vote-row button { min-height: 58rpx; padding: 0; border-radius: 5rpx; background: #2b3732; color: #e6e9e6; font-size: 20rpx; }
.result-emblem,.amulet-emblem { display: flex; width: 140rpx; height: 140rpx; margin: 20rpx auto 24rpx; align-items: center; justify-content: center; border: 4rpx solid; border-radius: 50%; font-size: 50rpx; font-weight: 900; animation: result-enter 360ms ease both; }
.mission-card-reveal { display: flex; width: 100%; min-height: 210rpx; padding: 20rpx 0 28rpx; align-items: center; justify-content: center; gap: 12rpx; perspective: 1200rpx; }
/* 翻牌用两段 scaleX 实现，不用双面 3D 翻转。
   微信渲染器里 backface-visibility 配合 preserve-3d 不可靠，正反面会同时可见；
   换成图片素材后两面叠加会比文字占位更明显。
   两面各自独立动画：牌背先 1→0 收起，牌面再 0→1 展开，任何时刻只有一面有宽度。
   逐张延迟由父元素的内联 --flip-delay 传入。 */
.mission-result-card { position: relative; width: 104rpx; height: 154rpx; animation: mission-card-drop 260ms cubic-bezier(.2,.75,.2,1) both; animation-delay: inherit; }
.mission-card-back,.mission-card-front { position: absolute; inset: 0; display: block; width: 100%; height: 100%; border-radius: 7rpx; box-sizing: border-box; box-shadow: 0 12rpx 24rpx rgba(0,0,0,.24); }
.mission-card-back { animation: card-face-out 280ms cubic-bezier(.55,0,1,.45) both; animation-delay: calc(var(--flip-delay, 0ms) + 260ms); }
.mission-card-front { transform: scaleX(0); animation: card-face-in 280ms cubic-bezier(0,.55,.45,1) both; animation-delay: calc(var(--flip-delay, 0ms) + 540ms); }
.result-good { border-color: #5aaa8c; color: #72c4a6; }
.result-evil { border-color: #c1656b; color: #dd7c82; }
.amulet-emblem { border-color: #c8aa62; color: #dec77f; }
.finale-content { width: 100%; }
.finale-banner { width: 100%; box-sizing: border-box; border-color: #8b555a; background: #2b2021; color: #e2aaa9; }
/* 只做不透明度淡入，不要任何 transform。
   原先用的 identity-reveal 关键帧含 perspective()+rotateY()，配合 both 填充模式
   会把 3D 变换永久留在元素上——视觉上是无操作，但强制建立 3D 渲染上下文，
   整个子树被推到独立合成层，后代元素的 boundingClientRect 全部失真
   （实测卡面宽度报 0、top 甚至比父容器还小）。卡片自身的 identity-card-in
   已经提供了入场效果，这层旋转既多余又有害。 */
.role-reveal-wrap { width: 100%; animation: reveal-fade 320ms ease both; }
@keyframes reveal-fade { from { opacity: 0; } to { opacity: 1; } }
.secret-intel { margin-top: 26rpx; padding: 20rpx; border-left: 7rpx solid #9a763c; background: #202623; }
.intel-title, .guide-title { margin-bottom: 8rpx; color: #d6dbd8; font-size: 23rpx; font-weight: 900; }
.intel-line { color: #cbd1ce; font-size: 24rpx; line-height: 1.55; }
.role-guide { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #28302c; }
.guide-goal { margin-bottom: 10rpx; color: #d4d9d7; font-size: 24rpx; line-height: 1.55; }
.guide-tip { margin-top: 7rpx; color: #b8c0bc; font-size: 22rpx; line-height: 1.5; }
.reading-clock { margin-top: 18rpx; color: #aeb7b2; font-size: 22rpx; text-align: center; }
.loyalty-preview { width: 100%; margin: 28rpx 0 20rpx; padding: 20rpx; border: 1rpx solid #282f2b; background: #1d2320; box-sizing: border-box; }
.loyalty-row { display: grid; width: 100%; margin: 22rpx 0; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14rpx; }
.loyalty-button.selected-loyalty { box-shadow: 0 0 0 7rpx rgba(47, 115, 88, 0.16); transform: translateY(-2rpx); }
.ceremony-content { min-height: 650rpx; justify-content: center; }
.ceremony-mark { position: relative; overflow: hidden; display: flex; width: 126rpx; height: 126rpx; margin: 0 auto 20rpx; align-items: center; justify-content: center; border: 2rpx solid #7c8880; border-radius: 50%; color: #d9ded9; font-size: 50rpx; font-weight: 900; }
.ceremony-step { color: #909993; font-size: 21rpx; text-align: center; }
.ceremony-text { min-height: 240rpx; padding: 42rpx 12rpx; color: #f0f2ef; font-size: 34rpx; font-weight: 700; line-height: 1.8; text-align: center; animation: script-enter 260ms ease both; }
.ceremony-controls { display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.icon-action { width: 76rpx; height: 76rpx; min-height: 76rpx; margin: 0; padding: 0; border: 2rpx solid #69736d; border-radius: 50%; background: #333d38; color: #eef1ed; font-size: 32rpx; }
.inline-action { width: auto; min-width: 300rpx; margin: 0; }
.empty-selection { width: 100%; padding: 26rpx 0; color: #8a8d88; font-size: 23rpx; text-align: center; }
.mission-vote[disabled] { opacity: 0.3; filter: grayscale(1); }
.result-title { margin-bottom: 10rpx; color: #ecf0ed; font-size: 38rpx; font-weight: 900; text-align: center; }
.handoff-actions { width: 100%; margin-top: 28rpx; }
.inspection-result { margin: 26rpx auto; padding: 24rpx 40rpx; border: 2rpx solid; border-radius: 6rpx; font-size: 38rpx; font-weight: 900; text-align: center; }
.good-result { border-color: #4f9274; background: #1d2320; color: #b7d9cc; }
.evil-result { border-color: #b75b55; background: #1c221f; color: #cfa19e; }
.final-timer { margin: 34rpx 0 20rpx; color: #ecdfb8; font-size: 92rpx; font-weight: 900; text-align: center; font-variant-numeric: tabular-nums; }
.inline-final-selector { width: 100%; margin-top: 18rpx; }
.final-selection-status { display: flex; margin-bottom: 12rpx; align-items: center; justify-content: space-between; color: #d8ddd9; font-size: 23rpx; font-weight: 900; }
/* 终局选人区要放得下满编座位：10 人局左右各 5 个，590rpx（295pt）高摆不开、
   座位会挤成一串。抬到 760rpx，桌子也才展示得全。 */
/* 870rpx 用掉的是实测出来的余量：终局屏视口 753pt、台面下方原本空着 87pt。
   加高是为了 10 人局——那是唯一放不下的情形，5~9 人局本来就宽裕。
   特异性必须压过 .compact-stage：两者同为单类时按顺序算，.compact-stage 定义在后，
   单写 .final-inline-stage 的高度会被它的 590rpx 覆盖——终局台面被截断就是这么来的。 */
.compact-stage.final-inline-stage { height: 870rpx; min-height: 870rpx; border-color: #4c5752; background: #241d18; }
.final-selection-actions { min-height: 108rpx; padding-top: 4rpx; }
.final-selection-hint { padding: 28rpx 0 16rpx; color: #8f9a94; font-size: 22rpx; text-align: center; }
.text-command { margin-top: 18rpx; border: 0; background: transparent; color: #9da69f; font-size: 23rpx; text-decoration: underline; }
.role-reveal-small { margin: 24rpx 0; padding: 20rpx; border: 3rpx solid #b14943; background: #5d2927; color: #f5dfdc; font-size: 36rpx; font-weight: 900; text-align: center; animation: mission-stamp 360ms ease both; }
.danger-seal { border-color: #b14943; color: #d96760; }
.table-overlay { position: fixed; inset: 0; z-index: 80; display: flex; align-items: flex-end; background: rgba(5, 10, 8, 0.76); animation: overlay-in 160ms ease both; }
.table-sheet { width: 100%; max-height: 92vh; padding: 24rpx; overflow-y: auto; border-radius: 8rpx 8rpx 0 0; background: #141c18; box-sizing: border-box; animation: sheet-up 220ms ease both; }
.sheet-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding-bottom: 14rpx; }
.sheet-handle { width: 72rpx; height: 7rpx; margin: -6rpx auto 18rpx; border-radius: 4rpx; background: #55635c; }
.modal-close { display: flex; width: 72rpx; height: 72rpx; margin: -8rpx -8rpx -8rpx 0; flex: none; align-items: center; justify-content: center; background: transparent; box-sizing: border-box; }
.modal-close-glyph { position: relative; width: 30rpx; height: 30rpx; }
.modal-close-glyph::before,.modal-close-glyph::after { position: absolute; top: 14rpx; left: 2rpx; width: 27rpx; height: 3rpx; border-radius: 2rpx; background: #c8d0cb; content: ""; }
.modal-close-glyph::before { transform: rotate(45deg); }
.modal-close-glyph::after { transform: rotate(-45deg); }
.modal-close:active { opacity: .5; transform: scale(.94); }
.sheet-actions { position: sticky; bottom: -24rpx; z-index: 5; padding: 16rpx 0 calc(24rpx + env(safe-area-inset-bottom)); background: #1b211e; }
.sheet-actions-syncing { pointer-events: none; }
.sheet-actions button[disabled] { background: #35403a; color: #f3eee4; opacity: 1; }
/* 底色跟着地毯转深，垫底图没加载出来时才不会闪一下浅灰 */
.compact-stage { position: relative; width: 100%; height: 590rpx; min-height: 590rpx; overflow: hidden; border: 2rpx solid #4a4038; border-radius: 8rpx; background: #241d18; box-sizing: border-box; }
/* 座位与头像放大到头像资产的设计尺寸（42pt）。
   不是靠加高舞台换来的——选人页舞台是 flex:1，10 人局实测 584pt 高、
   相邻座位净间距 25.8pt，一直有富余，是座位自己太小。 */
.game-seat-token { width: 92rpx; min-height: 92rpx; padding: 0; border: 0; background: transparent; box-shadow: none; overflow: visible; }
.game-seat-token .seat-avatar { width: 84rpx; height: 84rpx; margin: 0; border: 3rpx solid #8f9993; background: #405049; font-size: 22rpx; box-sizing: border-box; }
.game-seat-token .seat-caption { position: absolute; top: 70rpx; left: 50%; width: 126rpx; overflow: hidden; color: #e6e2d8; font-size: 18rpx; font-weight: 800; line-height: 27rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; transform: translateX(-50%); }
.game-seat-token.mine .seat-avatar { border-color: #3b8b6c; box-shadow: 0 0 0 5rpx rgba(59,139,108,.14); }
.game-seat-token.selected .seat-avatar,.game-seat-token.danger-selected .seat-avatar { border-color: #a74742; box-shadow: 0 0 0 7rpx rgba(167,71,66,.15); }
.game-seat-token.seat-disabled { opacity: .34; }
.game-seat-token .seat-badge { width: 34rpx; height: 34rpx; overflow: visible; border: 0; background: transparent; font-size: 26rpx; line-height: 1; }
.game-seat-token.seat-boarding .seat-avatar { animation: seat-board 520ms cubic-bezier(.18,.78,.22,1) both; }
.claim-submitted { margin-top: 12rpx; color: #bfc7c3; font-size: 23rpx; font-weight: 800; text-align: center; }
.directive-kicker { margin-bottom: 12rpx; color: #cdb270; font-size: 20rpx; font-weight: 900; }
.directive-progress { width: 70%; height: 7rpx; margin-top: 14rpx; overflow: hidden; border-radius: 4rpx; background: #34413b; }
.directive-progress view { height: 100%; border-radius: 4rpx; background: #cdb270; transition: width 1s linear; }
.leader-badge { top: -9rpx; left: -2rpx; }
.amulet-badge { right: -2rpx; bottom: -2rpx; }
.magic-badge { top: -9rpx; right: -2rpx; background: transparent; }
.faded-badge { left: -2rpx; bottom: -2rpx; background: transparent; filter: grayscale(1); opacity: .62; }
.sync-indicator { position: fixed; right: 20rpx; bottom: 20rpx; z-index: 100; padding: 10rpx 18rpx; border-radius: 4rpx; background: rgba(31, 39, 35, 0.88); color: #dde2de; font-size: 20rpx; }
button:active:not([disabled]) { transform: translateY(2rpx) scale(0.99); opacity: 0.86; }

/* Full-screen game actions */
.selector-overlay { z-index: 80; align-items: stretch; background: #1b211e; animation: none; }
.selector-page { display: flex; width: 100%; height: 100%; max-height: none; padding: 22rpx 24rpx calc(22rpx + env(safe-area-inset-bottom)); flex-direction: column; overflow: hidden; border-radius: 0; animation: selector-page-in 160ms ease-out both; }
.selector-page .sheet-head { flex: none; align-items: center; }
/* 底部留出按钮浮层的位置：不留的话最下排座位会被「确认交接」压住 */
.selector-page .compact-stage { height: auto; min-height: 0; flex: 1; margin: 8rpx 0 140rpx; }
/* 台面往上靠：按钮浮在它下缘，居中会把按钮推到地毯外面 */
.selector-page .compact-stage.round-seat-stage { width: 650rpx; height: 650rpx; min-height: 650rpx; flex: none; align-self: center; margin: 8rpx 0 140rpx; }
.final-inline-stage.round-seat-stage { width: 660rpx; height: 660rpx; min-height: 660rpx; align-self: center; }
.selector-tools { display: flex; flex: none; align-items: center; gap: 4rpx; }
.selector-history { width: 58rpx; min-width: 58rpx; max-width: 58rpx; height: 58rpx; min-height: 58rpx; max-height: 58rpx; border-radius: 5rpx; }
/* 按钮区浮在地毯上：不占布局高度，桌子就不会因为按钮出现而上移；
   背景透明，也就没有那块突兀的白。按钮自己带深色底和投影，压得住毯面。 */
.selector-page { position: relative; }
.selector-page .sheet-actions { position: absolute; left: 24rpx; right: 24rpx; bottom: calc(30rpx + env(safe-area-inset-bottom)); z-index: 12; flex: none; padding: 0; background: transparent; }
.selector-page .sheet-actions button { box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, .45); }

.history-overlay { position: fixed; inset: 0; z-index: 110; background: #171f1c; animation: selector-page-in 160ms ease-out both; }
/* 密录是全屏浮层，会把外面的阅读计时整个盖住。这里补一枚常驻的，
   最后 5 秒转红并加脉冲——玩家常常正埋头看攻略，错过了就得重开一局才知道身份。 */
.dossier-clock { flex: none; margin-left: auto; margin-right: 16rpx; padding: 6rpx 16rpx; border: 2rpx solid #6f7c74; border-radius: 999rpx; color: #cfd8d2; font-size: 21rpx; font-weight: 800; }
.dossier-clock.urgent { border-color: #c4564a; background: rgba(196, 86, 74, .16); color: #ffb9ae; animation: clock-urge 1s ease-in-out infinite; }
@keyframes clock-urge { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }
.history-page { display: flex; width: 100%; height: 100%; padding: 22rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); flex-direction: column; box-sizing: border-box; }
.history-head { flex: none; align-items: center; border-bottom: 2rpx solid #34413b; }
.history-head .sheet-title { color: #f0ede6; }
.history-head .sheet-hint { color: #8e9993; }
.history-head .modal-close-glyph::before,.history-head .modal-close-glyph::after { background: #dfe4e0; }
.history-scroll { min-height: 0; flex: 1; padding-top: 12rpx; box-sizing: border-box; }
.history-empty { padding: 180rpx 20rpx; color: #8e9993; font-size: 24rpx; text-align: center; }
.history-round { padding: 22rpx 0; border-bottom: 2rpx solid #303c37; }
.history-round-head { display: flex; margin-bottom: 15rpx; align-items: center; justify-content: space-between; gap: 16rpx; }
.history-round-no { color: #f0ede6; font-size: 27rpx; font-weight: 900; }
.history-result { padding: 7rpx 12rpx; border: 2rpx solid; border-radius: 4rpx; font-size: 20rpx; font-weight: 800; }
.history-good { border-color: #4c8e73; color: #73b99c; }
.history-evil { border-color: #a95758; color: #dc7a7d; }
.history-line { display: grid; min-height: 48rpx; grid-template-columns: 92rpx minmax(0, 1fr); align-items: start; color: #d8ded9; font-size: 23rpx; line-height: 1.55; }
.history-line > text { color: #84918b; }
.history-label { display: flex; min-height: 34rpx; align-items: center; color: #84918b; font-size: 25rpx; }
.history-line > view { min-width: 0; word-break: break-all; }
.history-section-title { display: flex; padding: 30rpx 0 10rpx; align-items: center; gap: 10rpx; color: #d3b973; font-size: 24rpx; font-weight: 900; }
.history-amulet { display: grid; min-height: 70rpx; padding: 14rpx 0; grid-template-columns: 130rpx minmax(0, 1fr); align-items: center; border-bottom: 1rpx solid #303c37; color: #d8ded9; font-size: 22rpx; }
.history-amulet > text { color: #84918b; }

@keyframes selector-page-in { from { opacity: 0; } to { opacity: 1; } }

/* State-change ceremonies */
.handoff-preview { width: 100%; margin-bottom: 12rpx; border-top: 2rpx solid #34413b; border-bottom: 2rpx solid #34413b; }
.handoff-preview-item { display: flex; min-height: 78rpx; align-items: center; animation: handoff-preview-in 320ms ease-out both; }
.handoff-preview-item + .handoff-preview-item { border-top: 1rpx solid #34413b; }
.handoff-preview-symbol { display: flex; width: 48rpx; height: 48rpx; margin-right: 14rpx; flex: 0 0 auto; align-items: center; justify-content: center; font-size: 32rpx; }
.amulet-preview .handoff-preview-symbol { color: #73b9a2; }
.handoff-preview-label { color: #8f9a94; font-size: 18rpx; }
.handoff-preview-name { margin-top: 2rpx; color: #eee9df; font-size: 23rpx; font-weight: 900; }

.seat-token.leader-selected { border-color: #b58c3d; background: #202623; animation: crown-seat-lock 420ms ease-out both; }
.seat-token.amulet-selected { border-color: #3b8170; background: #1e2421; animation: amulet-seat-lock 480ms ease-out both; }
.seat-token.magic-selected { border-color: #a94c42; background: #1e2421; box-shadow: 0 0 0 9rpx rgba(169, 76, 66, 0.15); animation: magic-seat-token-lock 520ms ease-out both; }
.seat-token.magic-selected .seat-avatar { background: #8d3f38; }
.magic-rider .rider-avatar { animation: magic-seat-lock 520ms ease-out both; }

.ceremony-overlay { position: fixed; inset: 0; z-index: 96; display: flex; overflow: hidden; align-items: center; justify-content: center; background: rgba(8, 13, 11, 0.97); animation: ceremony-veil 180ms ease-out both; }
.ceremony-stage { position: relative; z-index: 2; display: flex; width: 100%; min-height: 560rpx; padding: 40rpx; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; text-align: center; }
.ceremony-ring { position: absolute; top: 50%; left: 50%; border: 2rpx solid rgba(207, 177, 105, 0.3); border-radius: 50%; transform: translate(-50%, -50%); animation: ceremony-ring 1.2s ease-out both; }
.ring-outer { width: 620rpx; height: 620rpx; }
.ring-inner { width: 410rpx; height: 410rpx; animation-delay: 100ms; }
.ceremony-amulet .ceremony-ring { border-color: rgba(89, 157, 133, 0.35); }
.ceremony-magic .ceremony-ring { border-color: rgba(194, 91, 78, 0.38); }
.ceremony-round .ceremony-ring,.ceremony-finale-good .ceremony-ring,.ceremony-mission-good .ceremony-ring { border-color: rgba(91, 169, 139, 0.4); }
.ceremony-finale-evil .ceremony-ring,.ceremony-hunter .ceremony-ring,.ceremony-mission-evil .ceremony-ring { border-color: rgba(207, 89, 91, 0.44); }
.ceremony-symbol { display: flex; width: 132rpx; height: 132rpx; align-items: center; justify-content: center; border: 4rpx solid #d0b36f; border-radius: 50%; background: #1c2521; color: #ead38c; box-shadow: 0 0 0 12rpx rgba(208, 179, 111, 0.12), 0 18rpx 46rpx rgba(0, 0, 0, 0.35); font-family: "Apple Color Emoji", "Segoe UI Emoji", sans-serif; font-size: 48rpx; font-weight: 900; animation: crown-flight 720ms cubic-bezier(0.18, 0.78, 0.22, 1) both; }
.ceremony-amulet .ceremony-symbol { border-color: #69a991; color: #91cfb8; animation-name: amulet-flight; }
/* 队徽图必须显式给尺寸。<image> 没有 CSS 尺寸时按图片自然尺寸渲染（213x240），
   会把 132rpx 的圆圈整个撑爆并被 overflow 裁掉——表现为「图标没生效」。 */
.ceremony-symbol-image { display: block; width: 84rpx; height: 84rpx; }
.ceremony-magic .ceremony-symbol { border-color: #c45c4f; background: #722f2b; color: #ffe6d1; box-shadow: 0 0 0 12rpx rgba(196, 92, 79, 0.13), 0 18rpx 48rpx rgba(65, 18, 15, 0.45); animation-name: magic-flight; }
.ceremony-round .ceremony-symbol,.ceremony-finale-good .ceremony-symbol,.ceremony-mission-good .ceremony-symbol { border-color: #69ad91; background: #245d4d; color: #e3f4ec; }
.ceremony-finale-evil .ceremony-symbol,.ceremony-hunter .ceremony-symbol,.ceremony-mission-evil .ceremony-symbol { border-color: #d56c70; background: #702e34; color: #ffe8e6; animation-name: mission-stamp; }
.ceremony-finale-good .ceremony-title,.ceremony-round .ceremony-title,.ceremony-mission-good .ceremony-title { color: #9dd2bc; }
.ceremony-finale-evil .ceremony-title,.ceremony-hunter .ceremony-title,.ceremony-mission-evil .ceremony-title { color: #e49a9d; }
.ceremony-target { display: flex; margin-top: 34rpx; flex-direction: column; align-items: center; animation: ceremony-target-in 430ms 430ms ease-out both; }
.ceremony-avatar { display: flex; width: 84rpx; height: 84rpx; align-items: center; justify-content: center; border: 3rpx solid #37423c; border-radius: 50%; background: #26342e; color: #f3eee4; font-size: 30rpx; font-weight: 900; }
.ceremony-crown .ceremony-avatar { border-color: #d0b36f; }
.ceremony-amulet .ceremony-avatar { border-color: #69a991; }
.ceremony-magic .ceremony-avatar { border-color: #c45c4f; }
.ceremony-target-name { margin-top: 10rpx; color: #c9d0cc; font-size: 22rpx; font-weight: 800; }
.ceremony-title { margin-top: 36rpx; color: #f3efe6; font-size: 42rpx; font-weight: 900; animation: ceremony-copy-in 360ms 520ms ease-out both; }
.ceremony-subtitle { margin-top: 10rpx; color: #aab4af; font-size: 23rpx; animation: ceremony-copy-in 360ms 610ms ease-out both; }
.ceremony-sparks { position: absolute; top: 132rpx; left: 50%; width: 260rpx; height: 220rpx; transform: translateX(-50%); }
.ceremony-sparks > view { position: absolute; width: 8rpx; height: 8rpx; border-radius: 50%; background: #d5b96e; animation: ceremony-spark 780ms ease-out both; }
.ceremony-sparks > view:nth-child(1) { top: 28%; left: 4%; }
.ceremony-sparks > view:nth-child(2) { top: 8%; right: 12%; animation-delay: 80ms; }
.ceremony-sparks > view:nth-child(3) { right: 0; bottom: 20%; animation-delay: 150ms; }
.ceremony-sparks > view:nth-child(4) { bottom: 5%; left: 15%; animation-delay: 210ms; }
.ceremony-amulet .ceremony-sparks > view { background: #70b099; }
.ceremony-magic .ceremony-sparks > view { background: #d86758; }

@keyframes handoff-preview-in { from { opacity: 0; transform: translateY(8rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes crown-seat-lock { 0% { transform: translate(-50%, -50%) scale(0.88); } 65% { transform: translate(-50%, -50%) scale(1.08); } 100% { transform: translate(-50%, -50%) scale(1); } }
@keyframes amulet-seat-lock { 0% { transform: translate(-50%, -50%) rotate(-10deg) scale(0.86); } 65% { transform: translate(-50%, -50%) rotate(3deg) scale(1.08); } 100% { transform: translate(-50%, -50%) rotate(0) scale(1); } }
@keyframes magic-seat-token-lock { 0% { transform: translate(-50%, -50%) scale(0.72); opacity: 0.4; } 55% { transform: translate(-50%, -50%) scale(1.14); opacity: 1; } 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; } }
@keyframes magic-seat-lock { 0% { transform: scale(0.72); opacity: 0.4; } 55% { transform: scale(1.14); opacity: 1; } 100% { transform: scale(1); opacity: 1; } }
@keyframes ceremony-veil { from { opacity: 0; } to { opacity: 1; } }
@keyframes ceremony-ring { 0% { opacity: 0; transform: translate(-50%, -50%) scale(0.35); } 45% { opacity: 1; } 100% { opacity: 0; transform: translate(-50%, -50%) scale(1.2); } }
@keyframes crown-flight { 0% { opacity: 0; transform: translateY(-220rpx) rotate(-18deg) scale(0.6); } 70% { opacity: 1; transform: translateY(14rpx) rotate(3deg) scale(1.08); } 100% { transform: translateY(0) rotate(0) scale(1); } }
@keyframes amulet-flight { 0% { opacity: 0; transform: rotate(-180deg) scale(0.25); } 72% { opacity: 1; transform: rotate(12deg) scale(1.12); } 100% { transform: rotate(0) scale(1); } }
@keyframes magic-flight { 0% { opacity: 0; transform: translateY(-260rpx) rotate(-25deg) scale(0.45); } 64% { opacity: 1; transform: translateY(22rpx) rotate(8deg) scale(1.16); } 82% { transform: translateY(-8rpx) rotate(-3deg) scale(0.96); } 100% { transform: translateY(0) rotate(0) scale(1); } }
@keyframes ceremony-target-in { from { opacity: 0; transform: scale(0.75); } to { opacity: 1; transform: scale(1); } }
@keyframes ceremony-copy-in { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes ceremony-spark { 0% { opacity: 0; transform: scale(0.2); } 40% { opacity: 1; transform: scale(1.7); } 100% { opacity: 0; transform: translateY(-34rpx) scale(0.5); } }
@keyframes rider-board { 0% { opacity: 0; transform: translateY(42rpx) scale(.72); } 70% { opacity: 1; transform: translateY(-5rpx) scale(1.08); } 100% { transform: translateY(0) scale(1); } }
@keyframes seat-board { 0% { transform: scale(.7); box-shadow: 0 0 0 0 rgba(47,115,88,.35); } 65% { transform: scale(1.18); box-shadow: 0 0 0 16rpx rgba(47,115,88,.08); } 100% { transform: scale(1); } }
@keyframes mission-card-drop { from { opacity: 0; transform: translateY(-38rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes card-face-out { from { transform: scaleX(1); } to { transform: scaleX(0); } }
@keyframes card-face-in { from { transform: scaleX(0); } to { transform: scaleX(1); } }

/* 我的密录：随时可回看自己的身份、查验与出牌 */
.header-tools { display: flex; align-items: center; gap: 10rpx; }
.dossier-identity { margin-bottom: 18rpx; padding: 24rpx 22rpx; border: 2rpx solid #48554f; border-left-width: 8rpx; border-radius: 6rpx; background: #1d2824; }
.dossier-identity.role-good { border-left-color: #2f7358; }
.dossier-identity.role-evil { border-left-color: #8b3f45; }
.dossier-section { margin-top: 22rpx; }
.dossier-row { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 4rpx; border-bottom: 2rpx solid #26302b; font-size: 25rpx; }
.dossier-round { color: #8e9993; font-size: 22rpx; white-space: nowrap; }
.dossier-main { flex: 1; color: #dfe4e0; }
.dossier-tag { padding: 4rpx 14rpx; border: 2rpx solid; border-radius: 4rpx; font-size: 22rpx; font-weight: 700; white-space: nowrap; }
.dossier-tag.faction-good,.dossier-tag.vote-success { border-color: #4f9a80; color: #8ecdb3; }
.dossier-tag.faction-evil,.dossier-tag.vote-fail { border-color: #c1656b; color: #e09b9e; }

/* 常驻「现在等谁」：让全场知道在等谁，而不是互相张望 */
.waiting-bar { display: flex; align-items: center; gap: 12rpx; margin-top: 10rpx; padding: 14rpx 18rpx; border: 2rpx solid #3d4a44; border-left: 6rpx solid #c8aa62; border-radius: 5rpx; background: #1b2420; }
.waiting-dot { width: 12rpx; height: 12rpx; flex: 0 0 12rpx; border-radius: 50%; background: #d8c27f; animation: waiting-pulse 1.6s ease-in-out infinite; }
.waiting-bar-text { flex: 1; color: #cfd6d1; font-size: 24rpx; }
.waiting-bar-progress { color: #d8c27f; font-size: 24rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
@keyframes waiting-pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .35; transform: scale(.75); } }

/* 首夜由房主逐条推进 */
.night-controls { display: flex; width: 100%; margin-top: 28rpx; gap: 16rpx; }
.night-controls button { flex: 1; margin: 0; }

/* 高频事件用不打断的顶部横幅，替代全屏仪式 */
.event-banner { position: fixed; top: 0; left: 0; right: 0; z-index: 97; display: flex; align-items: center; gap: 14rpx; padding: 22rpx 28rpx; border-bottom: 2rpx solid #3d4a44; background: rgba(20, 28, 24, 0.97); animation: banner-drop 260ms cubic-bezier(.2,.75,.2,1) both; }
.banner-symbol { font-family: "Apple Color Emoji", "Segoe UI Emoji", sans-serif; font-size: 34rpx; }
.banner-text { flex: 1; color: #e6ebe7; font-size: 26rpx; font-weight: 700; }
.banner-crown { border-bottom-color: #c8aa62; }
.banner-amulet { border-bottom-color: #69a991; }
.banner-magic { border-bottom-color: #c45c4f; }
@keyframes banner-drop { from { opacity: 0; transform: translateY(-100%); } to { opacity: 1; transform: translateY(0); } }

/* ── 身份牌：3:4 标准卡牌，卡面只放图 ──
   660x880rpx = 330x440pt，@3x 正好 990x1320，与云端资产 1:1 匹配。
   卡面上不叠任何文字：角色名、描述、密令、攻略全部排在卡片下方，
   否则内容高度约 934rpx，塞不进 880rpx 的 3:4 盒子。 */
/* 卡片本身不做位移缩放动画：对局页每 900ms 轮询一次 setData，
   元素反复重渲染会让带 fill-mode 的动画不断从头开始，
   实测卡片被永久钉在起始帧（matrix(0.94,0,0,0.94,0,14)），
   表现为一直小 6%、下偏 14pt。入场效果由外层 .role-reveal-wrap 的淡入提供。 */
/* 已确认记住后把牌扣回去，压暗表示不再可读 */

/* 卡片下方的身份文字 */


/* ── 身份牌舞台：点击翻牌，文字浮在牌面下半部 ──
   高度用 vh 自适应，保证小屏（iPhone SE 视口 603pt）也不需要滚动。
   52vh / 39vh 恰好是 3:4，与云端 990x1320 的立绘一致。 */
.identity-stage { position: relative; width: 39vh; height: 52vh; margin: 0 auto; border-radius: 30rpx; overflow: hidden; background: #1b2420; box-shadow: 0 20rpx 48rpx rgba(0,0,0,.42); }
/* 圆角必须 >= 卡背图自带的圆角（约图宽 4.8%），否则 fantasy 那张的白角会露出来 */
.card-face { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 30rpx; overflow: hidden; }
/* 用 transition 而不是 animation：对局页每 900ms 轮询 setData，
   带 fill-mode 的 animation 会被反复重启而永远走不完（已踩过）。 */
.card-back-face { transform: scaleX(1); transition: transform 220ms cubic-bezier(.55,0,1,.45); }
.identity-stage.flipped .card-back-face { transform: scaleX(0); }
.card-front-face { transform: scaleX(0); transition: transform 220ms cubic-bezier(0,.55,.45,1) 220ms; }
.identity-stage.flipped .card-front-face { transform: scaleX(1); }
.card-art { display: block; width: 100%; height: 100%; }

/* 提示压在卡面下缘会把画面挡住。调淡、缩小、往下贴，
   并垫一层由透明渐深的底，让字有对比度而不糊住图。 */
.flip-hint { position: absolute; left: 0; right: 0; bottom: 10rpx; padding: 24rpx 0 12rpx; color: #cbb77e; font-size: 21rpx; text-align: center; background: linear-gradient(to bottom, rgba(12,16,14,0) 0%, rgba(12,16,14,.40) 78%); animation: flip-hint-pulse 2.2s ease-in-out infinite; }
@keyframes flip-hint-pulse { 0%,100% { opacity: .34; } 50% { opacity: .60; } }

/* 牌面下半部的信息层：渐变保证文字在任何立绘上都可读 */
/* 底色压到 .78/.46：原先 .97/.92 几乎完全不透明，立绘下半截整个看不见。
   文字靠 text-shadow 保证可读，不再靠糊住画面。 */
.card-overlay { position: absolute; left: 0; right: 0; bottom: 0; padding: 100rpx 24rpx 22rpx; background: linear-gradient(to top, rgba(9,13,11,.78) 0%, rgba(9,13,11,.46) 48%, rgba(9,13,11,0) 100%); }
.card-overlay .overlay-faction,
.card-overlay .overlay-name,
.card-overlay .overlay-desc,
.card-overlay .overlay-intel-line { text-shadow: 0 2rpx 10rpx rgba(0,0,0,.92), 0 0 3rpx rgba(0,0,0,.7); }
.overlay-faction { font-size: 21rpx; font-weight: 800; letter-spacing: 2rpx; }
.overlay-faction.faction-good { color: #8ecdb3; }
.overlay-faction.faction-evil { color: #e09b9e; }
.overlay-name { margin: 4rpx 0 8rpx; color: #f4f6f3; font-size: 40rpx; font-weight: 900; }
.overlay-desc { color: #c3ccc6; font-size: 23rpx; line-height: 1.5; }
.overlay-intel { margin-top: 12rpx; padding-top: 12rpx; border-top: 2rpx solid rgba(200,170,98,.35); }
.overlay-intel-line { color: #e6d7a8; font-size: 22rpx; line-height: 1.5; }

.reading-actions { display: flex; margin-top: 16rpx; justify-content: center; }
/* 用 <view> 而不是 <button>：微信原生 button 的内部尺寸压不住，
   width:auto / fit-content 都不生效，实测始终被撑到 184pt。
   这里只需要一个可点的次要操作，view 的尺寸跟内容走，可控。 */
.ghost-action {
  flex: none;
  width: auto;
  align-self: center;
  min-height: 68rpx; margin: 0; padding: 0 34rpx; border: 2rpx solid #48554f; border-radius: 6rpx; background: #1d2824; color: #cfd6d1; font-size: 25rpx; }
.reading-clock { margin-top: 14rpx; }

/* 未揭示/已记住阶段用小尺寸卡背，给下面的按钮和进度留出空间 */
.identity-card-back { display: block; width: 18vh; height: 24vh; margin: 0 auto 20rpx; border-radius: 16rpx; background: #1b2420; box-shadow: 0 14rpx 32rpx rgba(0,0,0,.38); }
.identity-card-back.sealed { opacity: .5; }

/* 密录里的身份牌：小图 + 文字并排，任何阶段都能回看 */
.dossier-card { display: flex; margin-bottom: 18rpx; padding: 18rpx; align-items: center; gap: 18rpx; border: 2rpx solid #48554f; border-radius: 8rpx; background: #1d2824; }
.dossier-art { display: block; width: 150rpx; height: 200rpx; flex: 0 0 150rpx; border-radius: 6rpx; background: #141c18; }
.dossier-identity { flex: 1; border: 0; border-left: 6rpx solid #48554f; padding: 4rpx 0 4rpx 16rpx; margin: 0; background: transparent; }
.dossier-identity.role-good { border-left-color: #2f7358; }
.dossier-identity.role-evil { border-left-color: #8b3f45; }
.dossier-faction { color: #8e9993; font-size: 21rpx; }
.dossier-name { margin: 4rpx 0 8rpx; color: #f0f2ef; font-size: 36rpx; font-weight: 900; }
.dossier-desc { color: #b9c2bc; font-size: 23rpx; line-height: 1.55; }

@keyframes mission-orb-spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }

/* 退伍队长标识：与褪色护身符同样处理——同一张 crown.png 走 CSS 灰度，
   不另外出图。这样天然保证与在任皇冠同角度同构图。 */
.retired-badge { right: -2rpx; bottom: -2rpx; background: transparent; filter: grayscale(1); opacity: .55; }
.faded-crown-icon { width: 26rpx; height: 26rpx; }

/* 投票：两张真实卡面。选中的翻转投出，另一张碎裂消失。
   用 transition 而非 animation——对局页每 900ms 轮询 setData，
   带 fill-mode 的 animation 会被反复重启（本项目已踩过两次）。 */
.vote-cards { display: flex; margin: 24rpx 0 8rpx; justify-content: center; gap: 40rpx; }
/* flex: none 是必须的：上面那条旧的 .vote-card 规则带 flex: 1，会把卡片按父容器
   均分拉宽，而高度是写死的 308rpx——比例一变，aspectFill 就把牌面上下裁掉。
   牌面图是 156x231（0.675），这里的 208x308rpx 就是照着这个比例定的，不要改单边。 */
.vote-card { position: relative; width: 208rpx; height: 308rpx; flex: none; border-radius: 10rpx; overflow: hidden; box-shadow: 0 14rpx 30rpx rgba(0,0,0,.38); transition: transform 520ms cubic-bezier(.4,0,.2,1), opacity 420ms ease; }
.vote-card-art { display: block; width: 100%; height: 100%; }
.vote-card.card-locked { filter: grayscale(1); opacity: .32; }
/* 选中：翻面并向上投递出去 */
.vote-card.card-cast { transform: translateY(-260rpx) rotateY(180deg) scale(.72); opacity: 0; }
/* 未选中：原地碎裂消散 */
.vote-card.card-shatter { transform: scale(.86) rotate(-6deg); opacity: 0; filter: blur(6rpx) saturate(.4); }

/* 远征记录里标出自己那一轮打的牌 */
.history-mine .mine-vote { padding: 2rpx 14rpx; border: 2rpx solid; border-radius: 4rpx; font-size: 22rpx; font-weight: 700; }
.history-mine .vote-success { border-color: #4f9a80; color: #8ecdb3; }
.history-mine .vote-fail { border-color: #c1656b; color: #e09b9e; }

/* 待交付的道具：选人前在桌心放大晃动，选中后飘向该玩家头像。
   座位坐标本来就是百分比，所以直接过渡 left/top 即可，不需要算像素。
   用 transition 不用 animation——轮询 setData 会重启带 fill-mode 的动画。 */
.deliver-token { position: absolute; left: 50%; top: 50%; z-index: 6; transform: translate(-50%, -50%); transition: left 620ms cubic-bezier(.3,0,.2,1), top 620ms cubic-bezier(.3,0,.2,1), transform 620ms cubic-bezier(.3,0,.2,1); }
.deliver-icon { display: block; width: 104rpx; height: 104rpx; filter: drop-shadow(0 8rpx 18rpx rgba(0,0,0,.45)); animation: deliver-wobble 1.7s ease-in-out infinite; }
/* 只缩小、**不淡出**：终点就是徽标位置、缩到徽标那么大（28/104 ≈ 0.27），
   飞完瞬间撤掉道具、徽标顶上，看不出交接。淡出会让人看到「先消失再冒出来」两段。 */
.deliver-token.flying { transform: translate(-50%, -50%) scale(.27); }
.deliver-token.flying .deliver-icon { animation: none; }
@keyframes deliver-wobble {
  0%, 100% { transform: rotate(-7deg) translateY(0); }
  50% { transform: rotate(7deg) translateY(-12rpx); }
}


/* 选人时随时看得到还差几个人——原先只有选满后才冒出「队伍已选齐」的按钮，
   过程中完全没有反馈 */
.team-counter { flex: none; margin-left: auto; margin-right: 16rpx; padding: 6rpx 18rpx; border: 2rpx solid #6f7c74; border-radius: 999rpx; color: #cfd8d2; font-size: 24rpx; font-weight: 800; }
.team-counter.ready { border-color: #3b8b6c; background: rgba(59,139,108,.18); color: #9fe0c2; }

/* 逐步模式的推进条：固定在底部，和对局内容分开，一眼看到「现在卡在谁身上」 */
.bot-step-bar { position: fixed; left: 20rpx; right: 20rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); z-index: 90; display: flex; align-items: center; gap: 16rpx; padding: 14rpx 16rpx 14rpx 22rpx; border: 2rpx solid #4a5b52; border-radius: 14rpx; background: rgba(20,28,24,.96); box-shadow: 0 12rpx 30rpx rgba(0,0,0,.5); }
.bot-step-label { flex: 1; color: #cfd8d2; font-size: 24rpx; font-weight: 700; }
.bot-step-action { flex: none; min-height: 66rpx; padding: 0 26rpx; border-radius: 10rpx; background: #2f7358; color: #eaf3ee; font-size: 25rpx; font-weight: 800; }
.bot-step-action[disabled] { background: #33413a; color: #8a988f; }

/* 双败保护标签：这条规则直接改变出牌判定，要一眼看到，不能混在小字里 */
.protect-tag { flex: none; margin-left: 10rpx; padding: 3rpx 12rpx; border: 2rpx solid #d0b36f; border-radius: 999rpx; color: #ead38c; font-size: 19rpx; font-weight: 800; }

/* 首夜屏：真人主持念稿，屏幕上只留月亮 + 一句话 + 房主的「天亮」按钮。
   玩家全程闭着眼，多写一个字都是给房主添乱。 */
.night-title { margin-bottom: 6rpx; color: #e8ebe6; font-size: 36rpx; font-weight: 900; letter-spacing: 4rpx; text-align: center; }

/* 私密选择的左右打乱。
   用 row-reverse 翻转视觉顺序，DOM 顺序和 data-value 都不动——
   这样翻转不可能把「点了成功却提交失败」这种错误引进来。
   .loyalty-row 是 grid，grid 也认 row-reverse 之外的写法，所以单独给它 direction。 */
.swap-order { flex-direction: row-reverse; }
.loyalty-row.swap-order { direction: rtl; }
.loyalty-row.swap-order > button { direction: ltr; }

.choice-row { display: flex; gap: 16rpx; }
.choice-row > button { flex: 1; margin: 0; }

/* 说明小字：告诉玩家位置是乱的，别照着别人点；也等于告诉旁观者看落点没用 */
.shuffle-note {
  margin: 8rpx 0 2rpx;
  color: #8b968a;
  font-size: 20rpx;
  text-align: center;
}

/* 阅读时间在密录开着时走完了，就在密录里把这一步收尾 */
.dossier-finish {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #2a332e;
}
.dossier-finish .primary-action { width: 100%; }

/* 顶栏两个入口从「密」单字和三横图形换成短词：
   单字和抽象图形在这个尺寸下没人猜得出是什么，短词一眼就懂。 */
.icon-button-text {
  color: #cfd6d1;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

/* .table-icon-button 是固定 58rpx 的方块，装不下「身份牌」三个字。
   带文字的这两个按内容撑开，高度仍和方块按钮对齐。 */
.table-icon-button.text-button {
  width: auto;
  min-width: 0;
  max-width: none;
  padding: 0 16rpx;
  flex: none;
}

/* 身份牌大图：对局中随时点开看清楚，也方便给同桌看一眼。
   z-index 要压过身份信息浮层（110），否则从浮层里点开会被它盖住。 */
.role-art-overlay {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 40rpx;
  background: rgba(6, 10, 8, 0.94);
  box-sizing: border-box;
}
.role-art-full {
  width: 100%;
  max-width: 620rpx;
  height: 70vh;
  border-radius: 12rpx;
}
.role-art-caption { color: #ead38c; font-size: 30rpx; font-weight: 800; }
.role-art-close { color: #8b968a; font-size: 22rpx; }


/* 微信原生的 button[disabled] 会刷一层近白底（实测 rgb(250,250,250)），
   在深色主题上就是一块刺眼的白。单类选择器压不过它，这里用父级提高特异性。 */


/* 队长选择那一屏的立绘。立绘是 3:4，容器同比例，aspectFill 才不会裁人。
   尺寸沿用揭示页那张牌，两处观感一致。 */
.claim-card {
  position: relative;
  width: 39vh;
  height: 52vh;
  margin: 22rpx auto 6rpx;
  overflow: hidden;
  border: 2rpx solid #3d4a44;
  border-radius: 24rpx;
  background: #1b2420;
}
.claim-card-art { display: block; width: 100%; height: 100%; }
/* 名字压在牌面下缘，不额外占竖向空间 */
.claim-card-label {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 46rpx 22rpx 18rpx;
  background: linear-gradient(180deg, rgba(12, 17, 15, 0) 0%, rgba(12, 17, 15, 0.86) 58%);
}
.claim-card-faction { display: block; font-size: 21rpx; font-weight: 800; letter-spacing: 3rpx; }
.claim-card-name { display: block; margin-top: 2rpx; color: #f2efe7; font-size: 36rpx; font-weight: 900; }

/* 阵营按钮：原来是细边框 + 中性深底，像个表单控件。
   改成带阵营色的实心牌面——正义/邪恶一眼分得出，不用读字。 */
.loyalty-button {
  min-height: 100rpx;
  margin: 0;
  border: 2rpx solid #3f8a68;
  border-radius: 10rpx;
  background: linear-gradient(180deg, #2c6b52 0%, #1f4d3a 100%);
  color: #eaf6f0;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.08), 0 6rpx 14rpx rgba(0, 0, 0, 0.32);
}
.loyalty-button.evil-choice {
  border-color: #b1544e;
  background: linear-gradient(180deg, #8a3b35 0%, #5f2723 100%);
  color: #fbeae8;
}
/* 微信原生 button[disabled] 会刷一层近白底，单类选择器压不过它，
   用父级提高特异性。禁用的要明确沉下去，但仍看得出是哪一方。 */
.loyalty-row > .loyalty-button[disabled],
.loyalty-row > .loyalty-button[disabled].evil-choice {
  border-color: #2c3531;
  background: #191e1c;
  color: #5d6963;
  box-shadow: none;
  opacity: 1;
}
