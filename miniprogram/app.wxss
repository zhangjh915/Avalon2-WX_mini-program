page {
  min-height: 100%;
  background: #1a1f1c;
  color: #e2e5e3;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

/* 微信原生给 button[disabled] 刷一层近白底（实测 rgb(250,250,250)），
   在深色主题上就是一块刺眼的白。它的内建选择器特异度不低，各页面此前是
   一处一处硬猜特异度去压（8 处、3 种写法），猜不中就漏一块白出来。
   这里一次性中和成「继承自己那条规则的配色」，之后各类只需普通特异度
   声明禁用色即可。和下面 button::after 的做法同构。 */
button[disabled],
button[disabled][disabled] {
  background-color: inherit;
  color: inherit;
  opacity: 1;
}

button::after {
  border: 0;
}

button:active,
.btn:active {
  transform: scale(0.985);
  filter: brightness(0.96);
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.panel {
  background: #151917;
  border: 2rpx solid #262e2a;
  border-radius: 14rpx;
  padding: 24rpx;
  box-sizing: border-box;
  margin-bottom: 22rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 12rpx;
}

.subtitle {
  color: #b7bfbb;
  line-height: 1.5;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.muted {
  color: #b7bfbb;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.btn {
  border-radius: 10rpx;
  background: #6f4728;
  color: #fff8ec;
  font-weight: 700;
}

.btn.secondary {
  background: #202724;
  color: #dde1df;
}

.btn.danger {
  background: #9b3d35;
}

.btn.ghost {
  border: 2rpx solid #2a322e;
  background: #151917;
  color: #dde1df;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: #1e2421;
  color: #d3d8d6;
  font-size: 23rpx;
  box-sizing: border-box;
}

.tag.good {
  background: #1d2320;
  color: #c3e1cd;
}

.tag.evil {
  background: #1d2320;
  color: #deb6b0;
}

.tag.dark {
  background: #332820;
  color: #fff4e5;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.player-card {
  border: 2rpx solid #262e2a;
  border-radius: 12rpx;
  background: #141816;
  padding: 18rpx;
  box-sizing: border-box;
}

.player-card.active {
  border-color: #8c5a2e;
  background: #1a1f1d;
}

.player-name {
  font-weight: 800;
  font-size: 29rpx;
  margin-bottom: 8rpx;
}

.input {
  width: 100%;
  min-height: 72rpx;
  padding: 0 18rpx;
  border: 2rpx solid #2a322e;
  border-radius: 10rpx;
  background: #141816;
  box-sizing: border-box;
}

.spacer {
  height: 18rpx;
}

.table-stage {
  position: relative;
  width: 100%;
  min-height: 620rpx;
  border: 2rpx solid #262e2a;
  border-radius: 14rpx;
  background: radial-gradient(circle at center, #1f2522 0%, #383024 46%, #453b2c 100%);
  overflow: hidden;
  box-sizing: border-box;
}

.round-table {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border: 0;
  /* 投影必须保留、而且必须够深。桌面和地面都是正俯视平光，没有可见投影就完全
     没有深度线索，桌子读起来像一张贴在地毯上的贴纸。实机验证过这一条。 */
  box-shadow: 0 14rpx 25rpx rgba(20, 14, 10, 0.45);
  width: 360rpx;
  height: 360rpx;
  /* 必须保留：table-round.jpg 带黑色四角，靠这个圆角裁掉 */
  border-radius: 50%;
  overflow: hidden;
}

/* 长桌是七张整图按比例挑一张，尺寸和旋转都由 js 内联下发（要用运行时实测的
   stage 尺寸才能挑对档）。这里只负责不去干扰它。 */
.table-slot {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  /* 投影放在**不旋转的外层**：直接给 .long-table 加 box-shadow 的话，
     竖桌的 rotate(90deg) 会把阴影方向一起转过去（向下变成向右）。
     drop-shadow 跟随图片 alpha 形状，正好贴合图自带的圆角。 */
  filter: drop-shadow(0 7px 12px rgba(20, 14, 10, 0.45));
}

.long-table {
  display: block;
  border: 0;
  /* 圆角由图自带，别再裁：桌角的雕花包角伸出了圆弧之外，一裁就切掉 */
  border-radius: 0;
}

.table-emblem {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(65, 58, 42, 0.72);
  color: #f4d284;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 900;
}

.seat-token {
  position: absolute;
  width: 122rpx;
  min-height: 122rpx;
  border-radius: 50%;
  background: #151917;
  border: 4rpx solid #2a322e;
  box-shadow: 0 8rpx 18rpx rgba(64, 42, 25, 0.18);
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
  box-sizing: border-box;
  text-align: center;
}

.seat-token.mine {
  border-color: #2f8f63;
  background: #181c1a;
}

.seat-token.selected {
  border-color: #9b3d35;
  background: #161b18;
}

.seat-token.leader {
  border-color: #b8872f;
  background: #1c211e;
}

.seat-no {
  font-size: 22rpx;
  font-weight: 900;
  color: #dec9b9;
}

.seat-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #40372a, #8d6744);
  margin: 4rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff8ec;
  font-size: 24rpx;
  font-weight: 900;
}

.seat-name {
  max-width: 100rpx;
  font-size: 20rpx;
  color: #dde1df;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.seat-empty {
  color: #aeb7b3;
}

.mini-status {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.seat-token .mini-status {
  gap: 4rpx;
  margin-top: 4rpx;
}

.seat-token .tag {
  min-height: 28rpx;
  padding: 0 8rpx;
  font-size: 18rpx;
}

/* 原先这些图走 CSS background，要先换成 https 临时链接，而临时链接会过期成 403
   （实测生成后十几分钟就失效）。改用 <image src="cloud://"> 由微信自己解析，
   彻底不经手临时链接。代价是要多一层垫底元素，样式统一放在这里。 */
.stage-floor,
.page-bg,
.seal-base,
.floor-swatch-art {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  display: block;
}
/* 垫底图沉在最下，其余内容压在它上面。
   **只碰 z-index，绝对不要顺手加 position: relative**——.seat-token / .table-slot /
   .table-emblem 都是 absolute 定位的，而 `.table-stage > view` 的特异度 (0,1,1)
   高于 `.seat-token` 的 (0,1,0)，会把它们的 absolute 改写掉，
   left/top 于是相对文档流而不是台面，座位会整体跑出台面（实测跑到 137%、160%）。
   也不要给垫底图用 z-index: -1：.table-stage 自身没有建立层叠上下文，
   负值会让它掉到祖先背景后面，那是更难查的坑。 */
.table-stage > view,
.table-stage > image:not(.stage-floor) { z-index: 1; }
/* 飞行中的道具要压在座位之上。注意特异度：上面那条是 (0,1,1)，
   单写 .deliver-token 只有 (0,1,0) 会被它压成 z-index:1，
   而道具在 DOM 里排在座位之前，于是飞过去就被头像盖住了。 */
.table-stage > .deliver-token { z-index: 6; }

/* 座位头像图：填满圆形容器。头像自带圆底，外面不加环——
   加了环反而把本来就只有 32~42pt 的可视面积再吃掉一圈。 */
.seat-avatar-art {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 按钮文字垂直居中。
   小程序的 <button> 自带一个行高，一旦用 min-height 把盒子撑高、
   又没同步设行高，文字就贴在顶上（「让测试骑士行动」那颗被抓到过）。
   用 flex 居中而不是写死 line-height：按钮换行时行高会失效，flex 不会。
   放在 app.wxss 是因为这是所有按钮的通病，逐个补迟早再漏一个。 */
/* 名单里只有 .ghost-action 是 <view>（原生 button 的内部尺寸压不住，
   它单独改成了 view），类型选择器覆盖不到才点名。其余都是 <button>，
   开头那个类型选择器已经兜住——别再往这份名单里加类名。 */
button,
.btn,
.primary-action,
.secondary-action,
.launch-action,
.choice-action,
.loyalty-button,
.bot-step-action,
.join-room-action,
.ghost-action {
  display: flex;
  align-items: center;
  justify-content: center;
  /* 栅格/弹性布局里的项默认 min-width: auto，会以内容的最小宽度为下限。
     微信原生 button 自带左右内边距，算出来 184pt，塞进 1fr 的 166pt 轨道就顶出屏幕
     （「正义/邪恶」那一行实测溢出 12pt）。允许它按轨道收窄。 */
  min-width: 0;
  /* 文字换行时的行高交给这里，别在各自规则里写死 line-height: 88rpx 那种
     ——一换行每行都占满按钮高度，按钮就裂成两截（「指定魔法目标」被抓到过）。
     垂直居中已经由上面的 flex 负责，写死行高既多余又有害。 */
  line-height: 1.35;
}
