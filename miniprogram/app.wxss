page {
  min-height: 100%;
  background: #f6efe2;
  color: #271f18;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

button::after {
  border: 0;
}

button:active,
.btn:active {
  transform: scale(0.985);
  filter: brightness(0.96);
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.panel {
  background: #fffaf1;
  border: 2rpx solid #ddcfba;
  border-radius: 14rpx;
  padding: 24rpx;
  box-sizing: border-box;
  margin-bottom: 22rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 12rpx;
}

.subtitle {
  color: #786a59;
  line-height: 1.5;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.muted {
  color: #786a59;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.btn {
  border-radius: 10rpx;
  background: #6f4728;
  color: #fff8ec;
  font-weight: 700;
}

.btn.secondary {
  background: #e8ddce;
  color: #34271c;
}

.btn.danger {
  background: #9b3d35;
}

.btn.ghost {
  border: 2rpx solid #d6c6ae;
  background: #fffaf1;
  color: #34271c;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: #eee3d3;
  color: #4b3826;
  font-size: 23rpx;
  box-sizing: border-box;
}

.tag.good {
  background: #dcebdd;
  color: #245b37;
}

.tag.evil {
  background: #efd9d6;
  color: #803126;
}

.tag.dark {
  background: #332820;
  color: #fff4e5;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.player-card {
  border: 2rpx solid #ddcfba;
  border-radius: 12rpx;
  background: #fffdf8;
  padding: 18rpx;
  box-sizing: border-box;
}

.player-card.active {
  border-color: #8c5a2e;
  background: #fff2d8;
}

.player-name {
  font-weight: 800;
  font-size: 29rpx;
  margin-bottom: 8rpx;
}

.input {
  width: 100%;
  min-height: 72rpx;
  padding: 0 18rpx;
  border: 2rpx solid #d6c6ae;
  border-radius: 10rpx;
  background: #fffdf8;
  box-sizing: border-box;
}

.spacer {
  height: 18rpx;
}

.table-stage {
  position: relative;
  width: 100%;
  min-height: 620rpx;
  border: 2rpx solid #ddcfba;
  border-radius: 14rpx;
  background: radial-gradient(circle at center, #f5e4c8 0%, #ead4b2 46%, #d9bd92 100%);
  overflow: hidden;
  box-sizing: border-box;
}

.round-table {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border: 0;
  background-position: center;
  background-size: cover;
  /* 投影必须保留、而且必须够深。桌面和地面都是正俯视平光，没有可见投影就完全
     没有深度线索，桌子读起来像一张贴在地毯上的贴纸。实机验证过这一条。 */
  box-shadow: 0 14rpx 25rpx rgba(20, 14, 10, 0.45);
  width: 360rpx;
  height: 360rpx;
  /* 必须保留：table-round.jpg 带黑色四角，靠这个圆角裁掉 */
  border-radius: 50%;
  overflow: hidden;
}

/* 长桌是七张整图按比例挑一张，尺寸和旋转都由 js 内联下发（要用运行时实测的
   stage 尺寸才能挑对档）。这里只负责不去干扰它。 */
.table-slot {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  /* 投影放在**不旋转的外层**：直接给 .long-table 加 box-shadow 的话，
     竖桌的 rotate(90deg) 会把阴影方向一起转过去（向下变成向右）。
     drop-shadow 跟随图片 alpha 形状，正好贴合图自带的圆角。 */
  filter: drop-shadow(0 7px 12px rgba(20, 14, 10, 0.45));
}

.long-table {
  display: block;
  border: 0;
  /* 圆角由图自带，别再裁：桌角的雕花包角伸出了圆弧之外，一裁就切掉 */
  border-radius: 0;
}

.table-emblem {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(244, 210, 132, 0.72);
  color: #f4d284;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 900;
}

.seat-token {
  position: absolute;
  width: 122rpx;
  min-height: 122rpx;
  border-radius: 50%;
  background: #fffaf1;
  border: 4rpx solid #d6c6ae;
  box-shadow: 0 8rpx 18rpx rgba(64, 42, 25, 0.18);
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
  box-sizing: border-box;
  text-align: center;
}

.seat-token.mine {
  border-color: #2f8f63;
  background: #edf7ec;
}

.seat-token.selected {
  border-color: #9b3d35;
  background: #fff0ec;
}

.seat-token.leader {
  border-color: #b8872f;
  background: #fff3cf;
}

.seat-no {
  font-size: 22rpx;
  font-weight: 900;
  color: #6f4728;
}

.seat-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #d8c1a1, #8d6744);
  margin: 4rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff8ec;
  font-size: 24rpx;
  font-weight: 900;
}

.seat-name {
  max-width: 100rpx;
  font-size: 20rpx;
  color: #34271c;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.seat-empty {
  color: #8c7a65;
}

.mini-status {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.seat-token .mini-status {
  gap: 4rpx;
  margin-top: 4rpx;
}

.seat-token .tag {
  min-height: 28rpx;
  padding: 0 8rpx;
  font-size: 18rpx;
}

/* 原先这些图走 CSS background，要先换成 https 临时链接，而临时链接会过期成 403
   （实测生成后十几分钟就失效）。改用 <image src="cloud://"> 由微信自己解析，
   彻底不经手临时链接。代价是要多一层垫底元素，样式统一放在这里。 */
.stage-floor,
.page-bg {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  display: block;
}
/* 台面里的桌子、座位都要压在地毯之上 */
.table-stage > view,
.table-stage > image:not(.stage-floor) { position: relative; z-index: 1; }
.table-slot, .round-table, .seat-token, .table-emblem, .deliver-token { z-index: 2; }
