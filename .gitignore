# 依赖
node_modules/
.pnpm-store/
miniprogram_npm/

# 微信开发者工具本地配置（每台机器不同，不应共享）
project.private.config.json

# 临时与派生产物（PDF 拆页、探针截图等，均可重新生成）
tmp/

# 系统与日志
.DS_Store
*.log

# 生图试验产物（体积大且是一次性对比用；最终选定的资产放 miniprogram/assets/ 并提交）
docs/assets/generated/

# 云存储托管的美术资产：体积大且已上传到云端，本地只作为导出中转
# （任务牌很小，仍然入包入库；这两个目录同时排除打包，见 project.config.json 的 packOptions.ignore）
miniprogram/assets/roles/
miniprogram/assets/cards/identity/

# Python 缓存（脚本互相 import 时产生）
__pycache__/
*.pyc
scripts/.table-tiers.json
